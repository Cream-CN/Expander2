  <!-- Code Analysis：四个配置一律开启，并统一使用工程根目录下的 my.ruleset。
       注意：只有 RunCodeAnalysis=true 时，VC 的 CodeAnalysis 目标才会把
       CodeAnalysisRuleSet 翻译成 cl 的 /analyze:ruleset，并自动补上
       /analyze:rulesetdirectory（my.ruleset 依赖 <Include> 引入内置规则集，
       少了这个搜索目录 cl 会直接报 C1259 “无法分析规则集”）、
       EspXEngine 插件（CppCoreCheck 系列规则要靠它才会真正跑起来）和
       CODE_ANALYSIS 宏。只写 CodeAnalysisRuleSet 而不开 RunCodeAnalysis 时，
       规则集对构建没有任何作用（静默失效）。 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <CodeAnalysisRuleSet>$(ProjectDir)my.ruleset</CodeAnalysisRuleSet>
    <RunCodeAnalysis>true</RunCodeAnalysis>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <CodeAnalysisRuleSet>$(ProjectDir)my.ruleset</CodeAnalysisRuleSet>
    <RunCodeAnalysis>true</RunCodeAnalysis>
  </PropertyGroup>
